# Connection string PostgreSQL dari Neon Console.
# Pilih pooled connection string pada tombol Connect bila tersedia.
# Jangan gunakan awalan VITE_ untuk URL database yang bersifat rahasia.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Secret acak panjang untuk membaca pesanan dan mengubah status pesanan.
# Jangan gunakan awalan VITE_ untuk secret ini.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Nomor WhatsApp Admin ATLAS, format internasional tanpa tanda + atau spasi.
# Variabel VITE_ tersedia pada bundle browser; nomor ini memang bersifat publik.
VITE_ADMIN_WHATSAPP=6281234567890
